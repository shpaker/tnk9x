//kage:unit pixels

// Динамический свет игрового поля с трассировкой теней.
// Images[0] — сцена, Images[1] — маска материалов:
// R — непрозрачность, G — отражательная способность, B — блики только
// на светлых пикселях спрайта, A — доля рассеянного света источников
package main

// Источники: xy — центр в пикселях экрана, z — радиус, w — яркость
var Lights [24]vec4

// Цвета источников: rgb
var LightColors [24]vec4

// Конусы источников: xy — ось, z — косинус внешнего края, w — внутреннего;
// у всенаправленного z = -2, w = -1 — конус не ограничивает свет
var LightCones [24]vec4

var LightCount int


// Базовая освещённость сцены без источников
var Ambient float

// Доля света, видимая на чёрном полу, — световые пятна и тени
var Haze float

// Игровое поле: xy — левый верхний угол, zw — правый нижний
var FieldRect vec4

// Маска материалов выровнена по сетке cellSize пикселей от левого верхнего
// угла поля, материал внутри клетки однороден: луч обходится по клеткам
// точно, ни один скол или угол не проскакивает. maxCells покрывает
// диагональ радиуса фары (145 пикселей — около 74 клеток)
const (
	cellSize = 4.0
	maxCells = 80
)

// Допуск равенства моментов пересечения вертикальной и горизонтальной
// границ клетки: луч проходит ровно через угол
const cornerEpsilon = 1e-4

// Условная «бесконечность» для оси, вдоль которой луч не движется
const farAway = 1e30

// Плотность частично прозрачной поверхности на пиксель пути луча
const density = 0.12

// Стены — здания, сверху видна крыша: свет ложится только на фасад
// со стороны источника и гаснет на глубине rimWidth пикселей,
// крыша остаётся в общем освещении
const (
	rimWidth = 6.0
	rimSteps = 8
	wallCore = 0.0
)

// Металлический блеск освещённого фасада на единицу отражательной
// способности: спадает как сам свет и при ярком свете уходит в bloom
const metalSheen = 0.9

// Светлый пиксель спрайта — гребень волны или белый штрих льда —
// с зелёным выше highlightLow: блик нарастает до highlightHigh и там
// усилен в highlightGlint раз. Основа воды и серый лёд не бликуют.
// Мерцание воды задаёт смена кадров спрайта, а не шейдер
const (
	highlightLow   = 0.8
	highlightHigh  = 0.95
	highlightGlint = 1.8
)

// Фара не слепит у самого танка: конус набирает силу на первых
// coneNear пикселях, его свечение на полу приглушено до coneHaze
const (
	coneNear = 40.0
	coneHaze = 0.45
)

// cellOpacity — непрозрачность клетки сетки: маска в её центре
func cellOpacity(cell vec2, origin vec2) float {
	center := FieldRect.xy + (cell+vec2(0.5))*cellSize
	return imageSrc1At(center + origin).r
}

// visibility — доля света, дошедшего от источника до точки: луч обходится
// по клеткам маски материалов (Amanatides–Woo), непрозрачная стена
// обрывает его, лес ослабляет на точную длину пути внутри клетки.
// Когда луч проходит ровно через угол клеток, проверяются и обе боковые
// клетки: свет не просачивается по диагональному шву между блоками.
// Стена не затеняет саму себя: пока луч не вышел из стены,
// в которой начался, препятствия не учитываются.
// Клетка источника не проверяется: сам источник может стоять в стене
func visibility(pos vec2, target vec2, origin vec2) float {
	rayLength := distance(pos, target)
	if rayLength < 1 {
		return 1
	}
	// Луч в координатах клеток: от start до finish
	start := (pos - FieldRect.xy) / cellSize
	finish := (target - FieldRect.xy) / cellSize
	dir := finish - start
	cell := floor(start)
	lastCell := floor(finish)

	stepX := 1.0
	tMaxX := farAway
	tDeltaX := farAway
	if dir.x > 0 {
		tMaxX = (cell.x + 1 - start.x) / dir.x
		tDeltaX = 1 / dir.x
	} else if dir.x < 0 {
		stepX = -1.0
		tMaxX = (start.x - cell.x) / -dir.x
		tDeltaX = -1 / dir.x
	}
	stepY := 1.0
	tMaxY := farAway
	tDeltaY := farAway
	if dir.y > 0 {
		tMaxY = (cell.y + 1 - start.y) / dir.y
		tDeltaY = 1 / dir.y
	} else if dir.y < 0 {
		stepY = -1.0
		tMaxY = (start.y - cell.y) / -dir.y
		tDeltaY = -1 / dir.y
	}

	vis := 1.0
	inside := cellOpacity(cell, origin) > 0.99
	entered := 0.0
	for i := 0; i < maxCells; i++ {
		if cell.x == lastCell.x && cell.y == lastCell.y {
			break
		}
		left := min(min(tMaxX, tMaxY), 1.0)
		opacity := cellOpacity(cell, origin)
		if inside {
			if opacity < 0.99 {
				inside = false
			}
		} else if opacity > 0.99 {
			return 0
		}
		if !inside {
			vis *= exp(-opacity * density * (left - entered) * rayLength)
		}
		if left >= 1 {
			break
		}
		entered = left

		corner := abs(tMaxX-tMaxY) < cornerEpsilon
		if corner && !inside {
			if cellOpacity(cell+vec2(stepX, 0), origin) > 0.99 ||
				cellOpacity(cell+vec2(0, stepY), origin) > 0.99 {
				return 0
			}
		}
		if corner {
			cell += vec2(stepX, stepY)
			tMaxX += tDeltaX
			tMaxY += tDeltaY
		} else if tMaxX < tMaxY {
			cell.x += stepX
			tMaxX += tDeltaX
		} else {
			cell.y += stepY
			tMaxY += tDeltaY
		}
	}
	return vis
}

// rim — освещённость пикселя стены: глубина до края стены по пути
// к источнику, пройденная с шагом в пиксель; на кромке 1, в толще wallCore
func rim(pos vec2, target vec2, origin vec2) float {
	toLight := normalize(target - pos)
	depth := float(rimSteps + 1)
	for i := 1; i <= rimSteps; i++ {
		if imageSrc1At(pos+toLight*float(i)+origin).r < 0.99 {
			depth = float(i)
			break
		}
	}
	return mix(wallCore, 1, 1-smoothstep(1, rimWidth, depth))
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	origin := imageSrc0Origin()
	pos := srcPos - origin
	scene := imageSrc0At(srcPos)
	if pos.x < FieldRect.x || pos.y < FieldRect.y ||
		pos.x >= FieldRect.z || pos.y >= FieldRect.w {
		return scene
	}

	material := imageSrc1At(srcPos)
	wall := material.r > 0.99
	// Вода и лёд бликуют только светлыми пикселями спрайта: гребнями
	// волн на синей воде и белыми штрихами на сером льду
	highlight := smoothstep(highlightLow, highlightHigh, scene.g)
	sparkle := mix(1.0, highlightGlint*highlight, material.b)

	light := vec3(0)
	glow := vec3(0)
	glint := vec3(0)
	sheen := vec3(0)
	for i := 0; i < 24; i++ {
		if i >= LightCount {
			break
		}
		source := Lights[i]
		d := distance(pos, source.xy)
		if d >= source.z {
			continue
		}
		cone := LightCones[i]
		spot := 1.0
		if d >= 1 {
			spot = smoothstep(cone.z, cone.w, dot((pos-source.xy)/d, cone.xy))
		}
		if spot <= 0 {
			continue
		}
		vis := visibility(pos, source.xy, origin) * spot
		if vis <= 0 {
			continue
		}
		if wall && d >= 1 {
			vis *= rim(pos, source.xy, origin)
		}
		falloff := 1 - d/source.z
		// Всенаправленный свет спадает квадратично, фара — линейно
		// и дотягивается дальше; у танка фара набирает силу плавно
		profile := falloff
		haze := 1.0
		if cone.z > -1.5 {
			near := smoothstep(0, coneNear, d)
			profile *= near
			haze = coneHaze * near
		} else {
			profile *= falloff
		}
		attenuation := profile * source.w * vis
		rgb := LightColors[i].rgb
		light += rgb * attenuation
		// Свечение пола спадает линейно: пятно света шире блика,
		// тени за стенами видны на чёрном полу
		glow += rgb * (falloff * source.w * vis * haze)
		if wall {
			// Стена блестит только фасадом: rim уже в attenuation
			sheen += rgb * attenuation
		} else {
			glint += rgb * (falloff * attenuation * falloff)
		}
	}

	// Светлая поверхность (лёд) под фарой выбеливается: свет источников
	// на ней приглушен вплоть до полного, общий свет остаётся прежним
	lit := scene.rgb*(Ambient+light*material.a) +
		glow*Haze + (glint*sparkle+sheen*metalSheen)*material.g
	return vec4(lit, 1)
}
