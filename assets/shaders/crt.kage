//kage:unit pixels

// Итоговый проход: кадр логического экрана на выпуклом кинескопе
// со скруглёнными углами — апертурная маска, сканлайны с шириной
// луча по яркости, сведение каналов к краям, bloom, виньетка
// и помехи сигнала: зерно, мерцание, бегущая полоса и срыв строк.
// Images[0] — кадр с послесвечением, Images[1] — размытое свечение
// того же размера
package main

// Сила наложения bloom
var BloomStrength float

// Глубина сканлайнов; 0 — выключены (мелкий масштаб)
var ScanlineDepth float

// Сила апертурной маски; 0 — выключена (мелкий масштаб)
var MaskStrength float

// Сдвиг каналов R и B у края экрана в логических пикселях
var Convergence float

// Сила зерна: шум виден и на чёрном фоне
var Grain float

// Сила мерцания и бегущей полосы
var Noise float

// Срыв строк от 0 до 1: горизонтальное дрожание кадра при ударах
var Distortion float

// Номер кадра для анимации помех
var Time float

const (
	warpX            = 0.035
	warpY            = 0.045
	vignetteStrength = 0.4
	// cornerRadius — радиус скругления углов в логических пикселях
	cornerRadius = 12.0
	// tearAmplitude — сдвиг строки при полном срыве в логических пикселях
	tearAmplitude = 1.5
	// barPeriod — за сколько кадров бегущая полоса проходит экран
	barPeriod = 480.0
	pi        = 3.14159265
)

// warp — бочкообразное искривление в координатах [0, 1]
func warp(uv vec2) vec2 {
	p := uv*2 - 1
	p *= vec2(1+p.y*p.y*warpX, 1+p.x*p.x*warpY)
	return p/2 + 0.5
}

// cornerMask — 1 внутри скруглённого прямоугольника экрана,
// к краю гаснет за один логический пиксель
func cornerMask(pos vec2, size vec2) float {
	half := size / 2
	q := abs(pos-half) - (half - cornerRadius)
	d := length(max(q, 0)) - cornerRadius
	return clamp(0.5-d, 0, 1)
}

// bloomAt — билинейная выборка свечения: размытый слой не должен
// ступенчато повторять логические пиксели
func bloomAt(pos vec2, origin vec2) vec3 {
	q := pos - 0.5
	f := fract(q)
	base := floor(q) + 0.5 + origin
	c00 := imageSrc1At(base).rgb
	c10 := imageSrc1At(base + vec2(1, 0)).rgb
	c01 := imageSrc1At(base + vec2(0, 1)).rgb
	c11 := imageSrc1At(base + vec2(1, 1)).rgb
	return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y)
}

// hash — псевдослучайное число [0, 1) от точки
func hash(p vec2) float {
	return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453)
}

// apertureMask — вертикальные триады люминофора R, G, B по экранным
// пикселям; средняя яркость маски возвращается к единице
func apertureMask(x float) vec3 {
	dim := 1 - MaskStrength
	m := vec3(dim)
	column := mod(floor(x), 3)
	if column < 1 {
		m.r = 1
	} else if column < 2 {
		m.g = 1
	} else {
		m.b = 1
	}
	return m * 3 / (1 + 2*dim)
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	origin := imageSrc0Origin()
	size := imageSrc0Size()
	uv := warp((srcPos - origin) / size)
	if uv.x < 0 || uv.y < 0 || uv.x >= 1 || uv.y >= 1 {
		return vec4(0, 0, 0, 1)
	}

	pos := uv * size
	// Срыв строк: строки сбиваются волной, волна бежит по кадру
	pos.x += Distortion * tearAmplitude *
		(0.7*sin(pos.y*0.35+Time*0.9) + 0.3*sin(pos.y*1.7-Time*2.1))

	// Сведение: красный и синий лучи расходятся к краям экрана
	e := uv*2 - 1
	shift := e * Convergence
	c := vec3(
		imageSrc0At(pos+shift+origin).r,
		imageSrc0At(pos+origin).g,
		imageSrc0At(pos-shift+origin).b,
	)
	c += bloomAt(pos, origin) * BloomStrength

	// Сканлайны: центр логической строки ярче её границ; яркий луч
	// шире, и тёмная щель между строками на нём уже
	luma := clamp(dot(c, vec3(0.299, 0.587, 0.114)), 0, 1)
	depth := ScanlineDepth * (1 - 0.6*luma)
	scan := sin(pi * fract(pos.y))
	c *= mix(1-depth, 1+depth*0.2, scan*scan)

	c *= apertureMask(dstPos.x)

	// Помехи: зерно, мерцание кадра и медленная светлая полоса
	// Зерно в ячейках по пол-логического пикселя: экранный пиксель
	// на Retina слишком мелок, шум сливается
	cell := floor((srcPos - origin) * 2)
	grain := hash(cell+vec2(mod(Time, 97)*13.1, mod(Time, 89)*7.7)) - 0.5
	c *= 1 + grain*Grain*2
	c += grain * Grain
	c *= 1 + Noise*0.3*sin(Time*2.3)
	bar := fract(uv.y - Time/barPeriod) - 0.5
	c *= 1 + Noise*exp(-bar*bar*400)

	c *= 1 - vignetteStrength*dot(e, e)*dot(e, e)*0.25
	c *= cornerMask(uv*size, size)
	return vec4(c, 1)
}
