//kage:unit pixels

// Зрение игроков с памятью увиденного. Images[0] — память прошлого
// кадра, Images[1] — маска материалов (как у lighting.kage).
// Результат: R — видно сейчас (у стены — только фасад, обращённый
// к игроку), G — видно недавно (гаснет на Fade за кадр), B — видано
// когда-либо на этом уровне
package main

// Зрители — танки игроков: xy — глаза в пикселях экрана, zw — взгляд
var Viewers [2]vec4

var ViewerCount int

// Игровое поле: xy — левый верхний угол, zw — правый нижний
var FieldRect vec4

// Угасание памяти недавно увиденного за кадр — кратно 1/255:
// в 8-битной текстуре меньший шаг округлится до нуля
var Fade float

// Трассировка — как в lighting.kage
const (
	maxSteps   = 48
	stepLength = 3.0
	density    = 0.12
)

// Фасад — кромка стены шириной facadeWidth со стороны взгляда,
// как rim в lighting.kage: дальний фасад здания игроку не виден
const (
	facadeWidth = 4.0
	facadeSteps = 6
)

// Поле зрения, как types.ViewerEntity: вплотную — со всех сторон,
// дальше — передняя полусфера с мягким краем
const (
	auraRadius    = 28.0
	fieldCosOuter = -0.17
	fieldCosInner = 0.17
)

// visibility — доля взгляда, дошедшего от точки до глаз: непрозрачная
// стена обрывает его, лес ослабляет; стена не заслоняет саму себя.
// Совпадает с visibility из lighting.kage
func visibility(pos vec2, target vec2, origin vec2, steps float) float {
	vis := 1.0
	stepSize := distance(pos, target) / steps
	inside := imageSrc1At(pos+origin).r > 0.99
	for s := 1; s < maxSteps; s++ {
		if float(s) >= steps {
			break
		}
		p := mix(pos, target, float(s)/steps)
		opacity := imageSrc1At(p + origin).r
		if inside {
			if opacity < 0.99 {
				inside = false
			}
			continue
		}
		if opacity > 0.99 {
			return 0
		}
		vis *= exp(-opacity * density * stepSize)
	}
	return vis
}

// facing — обращена ли точка стены к глазам: глубина до края стены
// по пути к ним с шагом в пиксель; на кромке 1, в толще и за ней 0
func facing(pos vec2, eye vec2, origin vec2) float {
	toEye := normalize(eye - pos)
	depth := float(facadeSteps + 1)
	for i := 1; i <= facadeSteps; i++ {
		if imageSrc1At(pos+toEye*float(i)+origin).r < 0.99 {
			depth = float(i)
			break
		}
	}
	return 1 - smoothstep(1, facadeWidth, depth)
}

// seenBy — насколько пиксель виден хотя бы одному игроку: поле зрения
// и взгляд до него мимо зданий. facade — учитывать ли, что у стены
// видна только кромка со стороны игрока
func seenBy(pos vec2, origin vec2, facade bool) float {
	seen := 0.0
	for v := 0; v < 2; v++ {
		if v >= ViewerCount {
			break
		}
		viewer := Viewers[v]
		d := distance(pos, viewer.xy)
		field := 1.0
		if d > auraRadius {
			field = smoothstep(fieldCosOuter, fieldCosInner,
				dot((pos-viewer.xy)/d, viewer.zw))
		}
		if field <= seen {
			continue
		}
		if facade && d >= 1 {
			field *= facing(pos, viewer.xy, origin)
			if field <= seen {
				continue
			}
		}
		steps := clamp(ceil(d/stepLength), 1, maxSteps)
		seen = max(seen, field*visibility(pos, viewer.xy, origin, steps))
	}
	return seen
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	origin := imageSrc0Origin()
	pos := srcPos - origin
	if pos.x < FieldRect.x || pos.y < FieldRect.y ||
		pos.x >= FieldRect.z || pos.y >= FieldRect.w {
		return vec4(0, 0, 0, 1)
	}
	previous := imageSrc0At(srcPos)
	// Память — по всему видимому, с крышами: увиденное здание светлеет
	seen := seenBy(pos, origin, false)
	now := seen
	if imageSrc1At(srcPos).r > 0.99 {
		now = seenBy(pos, origin, true)
	}
	return vec4(now, max(previous.g-Fade, seen), max(previous.b, seen), 1)
}
